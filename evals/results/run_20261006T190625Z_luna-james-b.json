        "refused": false,
        "refusal_reason": null,
        "answer": "Among Texas hospitals with a reported rate, those without emergency services averaged 17.23 across 3 hospitals; those with emergency services averaged 17.32 across 255 hospitals.",
        "sql": "SELECT h.emergency_services, COUNT(DISTINCT t.facility_id) AS hospital_count, ROUND(CAST(AVG(t.score) AS DECIMAL), 2) AS average_pneumonia_30_day_readmission_rate FROM hq.v_tx_latest AS t JOIN hq.hospitals AS h ON h.facility_id = t.facility_id WHERE UPPER(t.measure_id) = UPPER('READM_30_PN') AND t.score IS NOT NULL AND UPPER(h.emergency_services) IN ('YES', 'NO') GROUP BY h.emergency_services ORDER BY UPPER(h.emergency_services) LIMIT 200",
